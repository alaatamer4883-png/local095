rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 1. المنتجات (Products Collection)
    // - القراءة متاحة للجميع (الزوار والعملاء) لتصفح المتجر
    // - الكتابة والتعديل مقتصرة على لوحة التحكم / المسؤولين
    // =========================================================================
    match /products/{productId} {
      allow read: if true;
      allow write: if true; // يمكن تقييدها بـ if request.auth != null في بيئة الإنتاج
    }

    // =========================================================================
    // 2. طلبات الشراء (Orders Collection)
    // - متاح لأي عميلة إنشاء طلب شراء جديد من صفحة checkout.html
    // - القراءة والتعديل متاحة لمتابعة وتحديث حالة الطلبات من لوحة التحكم
    // =========================================================================
    match /orders/{orderId} {
      allow create: if true;
      allow read, update: if true;
    }

    // =========================================================================
    // 3. سلال التسوق وقوائم الأمنيات (Carts & Wishlists)
    // - مسموح للعميلة حفظ ومزامنة سلتها ومفضلتها
    // =========================================================================
    match /carts/{userId} {
      allow read, write: if true;
    }
    
    match /wishlists/{userId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 4. استفسارات العميلات وخدمة التنسيق (Inquiries Collection)
    // - متاح للجميع إرسال استفسار أو طلب مساعدة
    // =========================================================================
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update: if true;
    }
  }
}
