{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "*.zip"
    ],
    "rewrites": [
      {
        "source": "/product",
        "destination": "/product.html"
      },
      {
        "source": "/category",
        "destination": "/category.html"
      },
      {
        "source": "/about",
        "destination": "/about.html"
      },
      {
        "source": "/checkout",
        "destination": "/checkout.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
